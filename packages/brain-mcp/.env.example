# Copy to .env (or set in your MCP client's "env" block) and fill in your key.
# The only required value is BRAIN_API_KEY.

# Required: plaintext X-API-Key minted in the isitme dashboard (API Keys panel).
BRAIN_API_KEY=isme_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Web API base URL. Default http://127.0.0.1:5050.
# (BRAIN_BASE_URL is accepted as an alias.)
BRAIN_API_BASE=http://127.0.0.1:5050

# Optional: per-request timeout in seconds (default 20).
# BRAIN_API_TIMEOUT=20

# Optional transport: stdio (default) | sse | streamable-http
# BRAIN_MCP_TRANSPORT=stdio
# BRAIN_MCP_HOST=127.0.0.1
# BRAIN_MCP_PORT=8088

# Optional: skip the startup key-validation handshake (offline/dev).
# BRAIN_MCP_SKIP_VALIDATION=1
