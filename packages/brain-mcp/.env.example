# Optional config for the Brain MCP server. There are NO required secrets:
# authentication is a one-time interactive Google login that caches tokens.
#
#   python -m brain_mcp login      # opens Google sign-in, caches ~/.isitme/credentials.json
#   python -m brain_mcp            # runs the server (refreshes the token automatically)

# Optional: Web API base URL. Default http://127.0.0.1:5050.
# (BRAIN_BASE_URL is accepted as an alias.)
BRAIN_API_BASE=http://127.0.0.1:5050

# Optional: per-request timeout in seconds (default 20).
# BRAIN_API_TIMEOUT=20

# Optional: where the OAuth token cache lives (default ~/.isitme/credentials.json).
# BRAIN_CREDENTIALS_PATH=~/.isitme/credentials.json

# Optional: loopback port used by `login` (redirect http://127.0.0.1:<port>/callback).
# Register the matching redirect URI in Google Cloud. Default 8765.
# BRAIN_OAUTH_REDIRECT_PORT=8765

# Optional transport: stdio (default) | sse | streamable-http
# BRAIN_MCP_TRANSPORT=stdio
# BRAIN_MCP_HOST=127.0.0.1
# BRAIN_MCP_PORT=8088

# Optional: skip the startup auth handshake (offline/dev).
# BRAIN_MCP_SKIP_VALIDATION=1
