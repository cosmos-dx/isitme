{
  "name": "isitme-web",
  "private": true,
  "version": "0.1.0",
  "description": "isitme local web product: FastAPI BFF (:5050) + React/Vite frontend (:4000).",
  "scripts": {
    "dev": "concurrently -k -n brain,api,web -c magenta,cyan,green \"npm:dev:brain\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:brain": "PYTHONPATH=../brain-core/src .venv/bin/python -m brain_core serve --host 127.0.0.1 --port 8077",
    "dev:api": ".venv/bin/python -m web_api --host 127.0.0.1 --port 5050",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "install:web": "npm --prefix frontend install",
    "test:api": ".venv/bin/python -m pytest api/tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
